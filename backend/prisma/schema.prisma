generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  @@map("users")

  id              String            @id @default(cuid())
  email           String            @unique
  name            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  farmAgenda      UserFarmAgenda[]
}

model Character {
  @@map("characters")

  id          String               @id @default(cuid())
  name        String               @unique
  title       String?
  element     String?
  rarity      Int?
  weaponType  String?
  imageUrl    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  farmDays    CharacterFarmDay[]
  agendaItems UserFarmAgenda[]
}

model Weapon {
  @@map("weapons")

  id          String              @id @default(cuid())
  name        String              @unique
  type        String?
  rarity      Int?
  imageUrl    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  farmDays    WeaponFarmDay[]
  agendaItems UserFarmAgenda[]
}

model CharacterFarmDay {
  @@map("character_farm_days")
  @@unique([characterId, day])

  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  day         WeekDay
  createdAt   DateTime  @default(now())
}

model WeaponFarmDay {
  @@map("weapon_farm_days")
  @@unique([weaponId, day])

  id        String    @id @default(cuid())
  weaponId  String
  weapon    Weapon    @relation(fields: [weaponId], references: [id], onDelete: Cascade)
  day       WeekDay
  createdAt DateTime  @default(now())
}

model UserFarmAgenda {
  @@map("user_farm_agenda")

  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  weaponId    String?
  weapon      Weapon?   @relation(fields: [weaponId], references: [id], onDelete: SetNull)
  day         WeekDay
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, day, characterId, weaponId])
}
